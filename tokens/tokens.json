{
  "$description": "lysosome design tokens (W3C Design Tokens Community Group format). Extracted from lysosome.dev. Colors carry a light-theme value in $extensions[\"dev.lysosome.modes\"].light; $value is the dark (default) theme. Generate CSS with: node scripts/build-tokens.mjs",
  "color": {
    "$type": "color",
    "$description": "Fluorescence-microscopy palette: a dark field like a stained slide; each stain encodes a meaning.",
    "bg": {
      "$value": "#110d1a",
      "$description": "Page background (the slide).",
      "$extensions": {
        "dev.lysosome.modes": {
          "light": "#f6f3fa"
        }
      }
    },
    "bg-deep": {
      "$value": "#0b0812",
      "$description": "Recessed areas, vignettes, text on tier-colored buttons.",
      "$extensions": {
        "dev.lysosome.modes": {
          "light": "#ece6f3"
        }
      }
    },
    "surface": {
      "$value": "#1a1526",
      "$description": "Cards, inputs, panels.",
      "$extensions": {
        "dev.lysosome.modes": {
          "light": "#ffffff"
        }
      }
    },
    "surface-2": {
      "$value": "#221b31",
      "$description": "Raised surface, inline code background.",
      "$extensions": {
        "dev.lysosome.modes": {
          "light": "#f3eef9"
        }
      }
    },
    "line": {
      "$value": "#2e2643",
      "$description": "Hairlines and borders.",
      "$extensions": {
        "dev.lysosome.modes": {
          "light": "#e1d9ec"
        }
      }
    },
    "ink": {
      "$value": "#eee8f7",
      "$description": "Primary text.",
      "$extensions": {
        "dev.lysosome.modes": {
          "light": "#1b1426"
        }
      }
    },
    "muted": {
      "$value": "#a99fbd",
      "$description": "Secondary text.",
      "$extensions": {
        "dev.lysosome.modes": {
          "light": "#5f5573"
        }
      }
    },
    "faint": {
      "$value": "#6f6585",
      "$description": "Tertiary text, captions, disabled.",
      "$extensions": {
        "dev.lysosome.modes": {
          "light": "#8d84a0"
        }
      }
    },
    "stain": {
      "$value": "#ff4d7e",
      "$description": "Brand color: LysoTracker red, the organelle itself. Links, focus, primary buttons, the membrane in the logo.",
      "$extensions": {
        "dev.lysosome.modes": {
          "light": "#d11d54"
        }
      }
    },
    "stain-ink": {
      "$value": "#1a0610",
      "$description": "Text on a stain-colored fill.",
      "$extensions": {
        "dev.lysosome.modes": {
          "light": "#ffffff"
        }
      }
    },
    "tier": {
      "$description": "Safety tiers. Every finding lysosome reports carries exactly one.",
      "regenerable": {
        "$value": "#6ef0b0",
        "$description": "GFP mint. Cheap to rebuild: build output, caches, clean merged worktrees.",
        "$extensions": {
          "dev.lysosome.modes": {
            "light": "#0b8a57"
          }
        }
      },
      "expensive": {
        "$value": "#ffc15e",
        "$description": "Amber. Regenerable but costly to get back: dependencies to re-download, AI models.",
        "$extensions": {
          "dev.lysosome.modes": {
            "light": "#a35f00"
          }
        }
      },
      "review": {
        "$value": "#92a9ff",
        "$description": "DAPI blue-violet. A human should look first: dirty or unpushed worktrees, Docker volumes.",
        "$extensions": {
          "dev.lysosome.modes": {
            "light": "#3a57d1"
          }
        }
      }
    }
  },
  "glow": {
    "$type": "number",
    "$description": "Glow strength multiplier for stain/tier halos (used in color-mix percentages).",
    "$value": 0.55,
    "$extensions": {
      "dev.lysosome.modes": {
        "light": 0.2
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": [
          "Bricolage Grotesque",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Headlines and the wordmark. Variable: wght 200-800, wdth 75-100, opsz 12-96. SIL OFL 1.1."
      },
      "body": {
        "$value": [
          "Instrument Sans",
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "sans-serif"
        ],
        "$description": "Body copy and UI. Variable: wght 400-700, wdth 75-100. SIL OFL 1.1."
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "SF Mono",
          "Menlo",
          "monospace"
        ],
        "$description": "Commands, paths, sizes, eyebrows. Variable: wght 400-800. SIL OFL 1.1."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "semibold": {
        "$value": 600,
        "$description": "Buttons, strong body text."
      },
      "wordmark": {
        "$value": 650,
        "$description": "Wordmark, card titles, table heads (Bricolage)."
      },
      "display": {
        "$value": 700,
        "$description": "Hero headline (Bricolage)."
      }
    },
    "stretch": {
      "$type": "dimension",
      "$description": "font-stretch percentages for Bricolage Grotesque (wdth axis).",
      "display": {
        "$value": {
          "value": 82,
          "unit": "%"
        }
      },
      "wordmark": {
        "$value": {
          "value": 88,
          "unit": "%"
        }
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "Type scale. Display sizes are fluid on the site; $value is the max, the clamp() is in $extensions.",
      "display": {
        "$value": {
          "value": 5.6,
          "unit": "rem"
        },
        "$extensions": {
          "dev.lysosome.css": "clamp(2.7rem, 7vw, 5.6rem)"
        }
      },
      "h2": {
        "$value": {
          "value": 3.3,
          "unit": "rem"
        },
        "$extensions": {
          "dev.lysosome.css": "clamp(2rem, 4.2vw, 3.3rem)"
        }
      },
      "h3": {
        "$value": {
          "value": 1.45,
          "unit": "rem"
        }
      },
      "wordmark": {
        "$value": {
          "value": 1.32,
          "unit": "rem"
        }
      },
      "lede": {
        "$value": {
          "value": 1.2,
          "unit": "rem"
        },
        "$extensions": {
          "dev.lysosome.css": "clamp(1.06rem, 1.4vw, 1.2rem)"
        }
      },
      "body": {
        "$value": {
          "value": 1.0625,
          "unit": "rem"
        }
      },
      "small": {
        "$value": {
          "value": 0.9,
          "unit": "rem"
        }
      },
      "eyebrow": {
        "$value": {
          "value": 0.78,
          "unit": "rem"
        }
      },
      "fine": {
        "$value": {
          "value": 0.74,
          "unit": "rem"
        }
      }
    },
    "letter-spacing": {
      "$type": "dimension",
      "display": {
        "$value": {
          "value": -0.028,
          "unit": "em"
        }
      },
      "wordmark": {
        "$value": {
          "value": -0.03,
          "unit": "em"
        }
      },
      "eyebrow": {
        "$value": {
          "value": 0.04,
          "unit": "em"
        }
      }
    },
    "line-height": {
      "$type": "number",
      "display": {
        "$value": 0.98
      },
      "body": {
        "$value": 1.6
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 6,
        "unit": "px"
      },
      "$description": "Inline code, focus ring, small tags."
    },
    "sm": {
      "$value": {
        "value": 10,
        "unit": "px"
      },
      "$description": "Small panels."
    },
    "md": {
      "$value": {
        "value": 14,
        "unit": "px"
      },
      "$description": "Default: cards, terminal, tables (site --radius)."
    },
    "lg": {
      "$value": {
        "value": 18,
        "unit": "px"
      },
      "$description": "Large cards, app mock."
    },
    "pill": {
      "$value": {
        "value": 999,
        "unit": "px"
      },
      "$description": "Buttons, chips, the signup row."
    }
  },
  "space": {
    "$type": "dimension",
    "1": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "2": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "3": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "4": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "5": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "6": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "7": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    },
    "8": {
      "$value": {
        "value": 64,
        "unit": "px"
      }
    },
    "gutter": {
      "$value": {
        "value": 40,
        "unit": "px"
      },
      "$description": "Page side padding; fluid on the site.",
      "$extensions": {
        "dev.lysosome.css": "clamp(16px, 4vw, 40px)"
      }
    },
    "max": {
      "$value": {
        "value": 1180,
        "unit": "px"
      },
      "$description": "Content max width."
    }
  },
  "shadow": {
    "$type": "shadow",
    "panel": {
      "$value": {
        "color": "#00000099",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 30,
          "unit": "px"
        },
        "blur": {
          "value": 80,
          "unit": "px"
        },
        "spread": {
          "value": -40,
          "unit": "px"
        }
      },
      "$description": "Terminal and large panels."
    },
    "float": {
      "$value": {
        "color": "#0000008c",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 24,
          "unit": "px"
        },
        "blur": {
          "value": 60,
          "unit": "px"
        },
        "spread": {
          "value": -24,
          "unit": "px"
        }
      },
      "$description": "Floating UI (menu bar popover)."
    },
    "glow-stain": {
      "$value": {
        "color": "#ff4d7e8c",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 0,
          "unit": "px"
        },
        "blur": {
          "value": 32,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "Fluorescent halo around the membrane. On the site it is computed from --glow: color-mix(in srgb, var(--stain) calc(var(--glow) * 90%), transparent)."
    }
  }
}
